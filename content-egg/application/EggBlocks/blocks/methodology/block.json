{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "eggb/methodology",
    "version": "1.0.0",
    "title": "Methodology",
    "category": "cegg-blocks",
    "icon": "clipboard",
    "description": "Explain how recommendations were evaluated with list, timeline, or grid layouts.",
    "textdomain": "content-egg",
    "editorScript": "file:./index.js",
    "render": "file:./render.php",
  "style": ["eggb-base", "file:./style-min.css"],
    "attributes": {
        "variant": {
            "type": "string",
            "default": "default",
            "enum": ["default", "timeline", "grid"]
        },
        "section_label": {
            "type": "string",
            "default": "Methodology"
        },
        "title": {
            "type": "string",
            "default": ""
        },
        "heading_tag": {
            "type": "string",
            "default": "h3",
            "enum": ["h1", "h2", "h3", "h4", "div"]
        },
        "description": {
            "type": "string",
            "default": ""
        },
        "items": {
            "type": "array",
            "default": []
        },
        "note": {
            "type": "string",
            "default": ""
        },
        "anchor": {
            "type": "string",
            "default": ""
        },
        "toc_label": {
            "type": "string",
            "default": ""
        },
        "include_in_toc": {
            "type": "boolean",
            "default": false
        },
        "level": {
            "type": "number",
            "default": 2
        },
        "color_scheme": {
            "type": "string",
            "default": "auto",
            "enum": ["auto", "light", "dark"]
        },
        "style": {
            "type": "object",
            "default": {
                "spacing": {
                    "margin": { "bottom": "1.5rem" }
                }
            }
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": ["bottom"]
        }
    }
}
