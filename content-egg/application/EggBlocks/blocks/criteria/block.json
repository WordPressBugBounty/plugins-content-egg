{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "eggb/criteria",
    "version": "1.0.0",
    "title": "Criteria",
    "category": "cegg-blocks",
    "icon": "search",
    "description": "Buying criteria with importance levels, guidance, and avoid notes.",
    "textdomain": "content-egg",
    "editorScript": "file:./index.js",
    "render": "file:./render.php",
  "style": ["eggb-base", "file:./style-min.css"],
    "attributes": {
        "variant": {
            "type": "string",
            "default": "default",
            "enum": ["default", "list", "plain"]
        },
        "section_label": {
            "type": "string",
            "default": "What to look for"
        },
        "title": {
            "type": "string",
            "default": ""
        },
        "heading_tag": {
            "type": "string",
            "default": "h2",
            "enum": ["h1", "h2", "h3", "h4", "div"]
        },
        "label_look_for": {
            "type": "string",
            "default": "Look for"
        },
        "label_avoid": {
            "type": "string",
            "default": "Avoid"
        },
        "criteria": {
            "type": "array",
            "default": []
        },
        "anchor": {
            "type": "string",
            "default": ""
        },
        "toc_label": {
            "type": "string",
            "default": ""
        },
        "include_in_toc": {
            "type": "boolean",
            "default": false
        },
        "level": {
            "type": "number",
            "default": 2
        },
        "color_scheme": {
            "type": "string",
            "default": "auto",
            "enum": ["auto", "light", "dark"]
        },
        "style": {
            "type": "object",
            "default": {
                "spacing": {
                    "margin": { "bottom": "1.5rem" }
                }
            }
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": ["bottom"]
        }
    }
}
